# Vite puts VITE_* values in the browser build. Only public values here.

# The collector base URL, without /v0/events.
# Local stack: http://localhost:3101. Hosted: your collector URL.
VITE_MANALENS_ENDPOINT=http://localhost:3101

# The project Publishable key (mana_pk_...). It is public and safe in a game build.
# Never put a Secret key (mana_sk_) or an API key in a game build.
VITE_MANALENS_PUBLISHABLE_KEY=

# Optional: context.app fields.
VITE_MANALENS_STOREFRONT=itch
VITE_MANALENS_BUILD=1
