; Manalens Godot example. Godot 4.5 or newer (engine errors need 4.5).
; Run: godot --path with-godot   (headless demo: see README.md)

config_version=5

[application]

config/name="Manalens Godot Example"
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")

[autoload]

Manalens="*res://addons/manalens/manalens.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=420

[editor_plugins]

enabled=PackedStringArray("res://addons/manalens/plugin.cfg")

[manalens]

publishable_key=""
endpoint="http://localhost:3101"
