# The collector base URL, without /v0/events.
# Local stack: http://localhost:3101. Hosted: your collector URL.
MANALENS_ENDPOINT=http://localhost:3101

# The project Secret key (mana_sk_...). Server only: never commit it, never put
# it in a page, a game build or an Electron app.
# Create it in Settings > General > Credentials.
MANALENS_SECRET_KEY=

# Optional: a shared secret that the purchase webhook must send in the
# x-webhook-secret header. Leave empty to accept every request (local only).
WEBHOOK_SECRET=

# Optional: the HTTP port.
PORT=3000
