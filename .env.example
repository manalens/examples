# For scripts/smoke.mjs. Use a test project: the smoke test sends real events.

# The collector base URL, without /v0/events.
MANALENS_ENDPOINT=http://localhost:3101

# The test project's Publishable key (mana_pk_...).
MANALENS_PUBLISHABLE_KEY=

# The test project's Secret key (mana_sk_...). Only the Node.js server checks
# use it. Never commit it.
MANALENS_SECRET_KEY=

# The host for the browser checks. Web events must come from a page on the
# project domain: use the project domain, or a subdomain of it. A local test
# project with domain "localhost" or "<name>.localhost" works with Chromium,
# which sends *.localhost to this machine.
MANALENS_PAGE_HOST=localhost

# Optional: run only some checks, comma-separated:
# express,electron-main,godot,unity,html,threejs,next,astro
MANALENS_SMOKE_ONLY=
