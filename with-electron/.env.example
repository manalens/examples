# The collector base URL, without /v0/events.
# Local stack: http://localhost:3101. Hosted: your collector URL.
MANALENS_ENDPOINT=http://localhost:3101

# The project Publishable key (mana_pk_...). It is safe to ship in the app.
# NEVER put a Secret key (mana_sk_) or an API key in an Electron app: anyone who
# has the app can read it.
MANALENS_PUBLISHABLE_KEY=

# The host the renderer page is served from. It must be your project domain or
# one of its subdomains, because the collector checks the page URL of web
# events. For a project with domain example.com, use game.example.com.
# Local test project with domain "localhost" or "<name>.localhost": use
# game.localhost or game.<name>.localhost.
MANALENS_RENDERER_HOST=game.localhost

# Optional
MANALENS_STOREFRONT=steam
MANALENS_BUILD=1
MANALENS_DEBUG=false
