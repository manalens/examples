# Unity does not read .env files. Use these as environment variables or as
# command-line arguments (see README.md), or set the constants at the top of
# Assets/Scripts/ExampleGame.cs.

# The collector base URL, without /v0/events.
MANALENS_ENDPOINT=http://127.0.0.1:3101

# The project Publishable key (mana_pk_...). It is safe to ship in a game build.
# Never put a Secret key (mana_sk_) or an API key in a game build.
MANALENS_PUBLISHABLE_KEY=
