# Manalens ---------------------------------------------------------------------

# The collector base URL, without /v0/events.
# Local stack: http://localhost:3101. Hosted: your collector URL.
MANALENS_ENDPOINT=http://localhost:3101

# The project Publishable key (mana_pk_...). It is public and safe in a page.
# Never put a Secret key (mana_sk_) or an API key in a page.
MANALENS_PUBLISHABLE_KEY=

# Stripe (optional) ------------------------------------------------------------

# A Stripe secret key, for the server only. Stripe test keys work for this
# example, but Manalens ignores test mode events: to see revenue in Manalens,
# connect a live account and make a small real purchase.
STRIPE_SECRET_KEY=
# The Stripe Price to sell (price_...).
STRIPE_PRICE_ID=

# Paddle Billing (optional) ----------------------------------------------------

# A Paddle client-side token (live_... or test_...). It is public: Paddle.js
# needs it in the page. Manalens refuses sandbox keys, so only a live account
# records revenue.
PADDLE_CLIENT_TOKEN=
# The Paddle price to sell (pri_...).
PADDLE_PRICE_ID=

# Optional: the HTTP port of the local server.
PORT=8090
