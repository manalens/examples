# NEXT_PUBLIC_* values go into the browser bundle. Only public values here.

# The collector base URL, without /v0/events.
# Local stack: http://localhost:3101. Hosted: your collector URL.
NEXT_PUBLIC_MANALENS_ENDPOINT=http://localhost:3101

# The project Publishable key (mana_pk_...). It is public and safe in a page.
# Never put a Secret key (mana_sk_) or an API key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_MANALENS_PUBLISHABLE_KEY=
