# PUBLIC_* values go into the built pages. Only public values here.

# The collector base URL, without /v0/events.
# Local stack: http://localhost:3101. Hosted: your collector URL.
PUBLIC_MANALENS_ENDPOINT=http://localhost:3101

# The project Publishable key (mana_pk_...). It is public and safe in a page.
# Empty turns analytics off: the pages then have no analytics script tag.
# Never put a Secret key (mana_sk_) or an API key in a PUBLIC_ variable.
PUBLIC_MANALENS_PUBLISHABLE_KEY=
